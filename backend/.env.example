NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# Postgres — local developer database
DATABASE_URL=postgresql://postgres:password@localhost:5432/event_ticketing

# Disposable database used by verification and CI; never point this at production
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5433/event_ticketing_test

# Pending checkout reservation lifetime
ORDER_RESERVATION_MINUTES=15

# JWT
JWT_SECRET=changeme_at_least_32_chars_long_xxxxxxxxxxx
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=changeme_refresh_at_least_32_chars_xxxxxxxxxx
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRY_MINUTES=1440

# Paystack (get keys from dashboard.paystack.com)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Cloudinary (get from cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Transactional email — Resend used as default; swap provider + key if using SendGrid
EMAIL_PROVIDER_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=tickets@yourdomain.com

# WhatsApp (Meta Cloud API) — keep WHATSAPP_ENABLED=false until Meta approves the account
WHATSAPP_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Swagger UI — set to false in production if you want /api/docs private
ENABLE_SWAGGER=true

# DB fields for docker-compose (used by the postgres service, not the app directly)
DB_PORT=5432
DB_NAME=event_ticketing
DB_USER=postgres
DB_PASSWORD=password